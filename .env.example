# ==============================================================================
# LOGICLEAR AI — CONFIGURACIÓN DE VARIABLES DE ENTORNO (TEMPLATE DE EJEMPLO)
# ==============================================================================
# IMPORTANTE: Copia este archivo a `.env.local` para desarrollo local:
# cp .env.example .env.local
# NUNCA confirmes claves reales o secretos privados a repositorios Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE LA APLICACIÓN
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS TRANSACCIONAL (POSTGRESQL MULTI-TENANT CON RLS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://logiclear_app:change_me_in_production@localhost:5432/logiclear_ai
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. EXTRACCIÓN MULTIMODAL GENAI (ZERO-HALLUCINATION / TEMP 0.0)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Pro / Vertex AI
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-pro

# Fallback Opcional (OpenAI GPT-4o)
OPENAI_API_KEY=your_openai_api_key_placeholder

# ------------------------------------------------------------------------------
# 4. FACTURACIÓN SAAS B2B (STRIPE BILLING & HMAC WEBHOOKS)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_51NExampleKeyOnly
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_51NExampleKeyOnly
STRIPE_WEBHOOK_SECRET=whsec_placeholder_test_hmac_secret_sha256

# IDs de Precios de Planes Stripe (Starter / Enterprise Pro)
STRIPE_PRICE_STARTER_MONTHLY=price_starter_99_usd_monthly
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_349_usd_monthly

# ------------------------------------------------------------------------------
# 5. SEGURIDAD, AUDITORÍA Y SESIONES
# ------------------------------------------------------------------------------
SESSION_SECRET=change_me_to_a_minimum_32_char_cryptographic_random_string
AUDIT_LOG_ENABLED=true
